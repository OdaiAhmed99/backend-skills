# Copy to .env and change every "change-me". Never commit .env.
# Works as-is for a local venv run: SQLite, no Redis, no Docker.
# docker compose sets POSTGRES_HOST and REDIS_URL itself in docker-compose.yml.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
# The project's one language - pick it when you start the project (en, ar, ...)
DJANGO_LANGUAGE_CODE=en

# --- Database ---
# Empty POSTGRES_HOST = SQLite file backend/db.sqlite3 (local). Docker sets POSTGRES_HOST=db.
POSTGRES_HOST=
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis (optional) ---
# Empty = in-memory cache, Celery tasks run inline. Local Redis:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Email (printed to the console locally) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com


# --- Ports ---
NGINX_PORT=80
